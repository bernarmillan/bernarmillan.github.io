---
// Versión INGLESA del portfolio: misma estructura que `/`, otro idioma.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import CapsuleCorp3D from '../../components/CapsuleCorp3D.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { getPortfolio } from '../../data/portfolio';

const lang = 'en' as const;
const { personalInfo } = getPortfolio(lang);
---

<Layout lang={lang} title={personalInfo.name}>
  <!-- 1. Floating iOS 27 Liquid Droplet Navbar -->
  <Navbar cvUrl={personalInfo.cvUrl} lang={lang} />

  <main class="relative z-10">
    <!-- 2. First Viewport: min 100dvh (Hero + Photo + 3 CV Pillars), crece si el contenido no cabe -->
    <Hero lang={lang} />

    <!-- 3. Showcase 3D Projects: Capsule Corp 3D (@capsulecorp.3d) Lookbook -->
    <CapsuleCorp3D lang={lang} />

    <!-- 4. Direct Contact & CV -->
    <Contact 
      email={personalInfo.email}
      linkedin={personalInfo.linkedin}
      github={personalInfo.github}
      instagramUrl={personalInfo.instagramUrl}
      cvUrl={personalInfo.cvUrl}
      lang={lang}
    />
  </main>

  <!-- 5. Editorial Minimalist Footer -->
  <Footer lang={lang} />
</Layout>
