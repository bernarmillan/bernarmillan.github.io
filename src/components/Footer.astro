---
import type { Lang } from '../data/portfolio';
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const { personalInfo } = getPortfolio(lang);
const t = getUi(lang);
---

<footer class="relative py-12 px-4 sm:px-6 md:px-8 border-t border-white/10 bg-black/40 backdrop-blur-md text-xs text-zinc-400">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Brand & Monogram -->
    <div class="flex items-center gap-3">
      <img 
        src="/brand/bm.png" 
        alt="" 
        width={28} 
        height={28} 
        decoding="async"
        class="drop-shadow-[0_2px_8px_rgba(255,255,255,0.25)]"
      />
      <div class="flex flex-col">
        <span class="font-display font-bold text-white tracking-wider text-sm uppercase">
          {personalInfo.name}
        </span>
        <span class="font-mono-tech text-[10px] text-zinc-500 tracking-widest uppercase">
          {personalInfo.editorialQuote}
        </span>
      </div>
    </div>

    <!-- Right: Links & Back to Top -->
    <div class="flex items-center gap-5">
      <a href={personalInfo.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
        Instagram
      </a>
      <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
        LinkedIn
      </a>
      <a href={personalInfo.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
        GitHub
      </a>
      <a href="#perfil" class="p-2 rounded-full border border-white/15 hover:border-white text-zinc-300 hover:text-white transition-all" title={t.footer.backToTop}>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
  </div>
</footer>
