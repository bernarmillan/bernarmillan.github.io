---
interface SkillItem {
  name: string;
  detail: string;
}

interface SkillCategory {
  title: string;
  icon: string;
  skills: SkillItem[];
}

interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;
---

<section id="habilidades" class="py-16 md:py-24 px-4 sm:px-6 bg-slate-50 border-t border-slate-200/60">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-600 mb-2">Competencias Técnicas</h2>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Habilidades clave estructuradas
      </h3>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Dos disciplinas conectadas: administración de sistemas de datos y fabricación física
      </p>
      <div class="w-12 h-1 bg-cyan-500 rounded-full mx-auto mt-4"></div>
    </div>

    <!-- Skills Categories Grid -->
    <div class="grid lg:grid-cols-3 gap-6">
      {categories.map((cat, idx) => (
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
              <span class="text-2xl p-2 rounded-xl bg-slate-100/80">{cat.icon}</span>
              <div>
                <h4 class="font-bold text-slate-900 text-base sm:text-lg">{cat.title}</h4>
                <span class="text-xs text-slate-400 font-medium">{cat.skills.length} competencias clave</span>
              </div>
            </div>

            <div class="space-y-3.5">
              {cat.skills.map(skill => (
                <div class="group">
                  <div class="flex items-center justify-between text-sm font-semibold text-slate-800 mb-0.5">
                    <span class="group-hover:text-cyan-600 transition-colors flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                      {skill.name}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 pl-3 leading-snug">
                    {skill.detail}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>Orientado a aplicación práctica</span>
            <span class="text-cyan-600 font-medium">✓ Verificado</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>