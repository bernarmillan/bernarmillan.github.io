---
interface Props {
  bio: string;
}

const { bio } = Astro.props;
---

<section id="sobre-mi" class="py-16 md:py-24 px-4 sm:px-6 bg-white border-t border-slate-100">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-600 mb-2">Perfil Profesional</h2>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Sobre mí: del retail a la infraestructura y el diseño 3D
      </h3>
      <div class="w-12 h-1 bg-cyan-500 rounded-full mx-auto mt-4"></div>
    </div>

    <!-- Executive Bio Note -->
    <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-r from-slate-50 via-slate-50/70 to-cyan-50/30 border border-slate-200/80 mb-12 shadow-sm">
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
        {bio}
      </p>
    </div>

    <!-- 3 Pillars Grid (Scannable in 10 seconds) -->
    <div class="grid md:grid-cols-3 gap-6">
      <!-- Pillar 1 -->
      <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200 hover:border-cyan-400/60 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-blue-100/80 text-blue-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          👔
        </div>
        <h4 class="text-lg font-bold text-slate-900 mb-2">5 años en Retail</h4>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Resolución directa de incidencias, comunicación asertiva con clientes, control de inventario y arqueos. Madurez profesional y resistencia al estrés.
        </p>
        <span class="inline-block text-[11px] font-semibold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md">
          Soft skills contrastadas
        </span>
      </div>

      <!-- Pillar 2 -->
      <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200 hover:border-cyan-400/60 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-cyan-100/80 text-cyan-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🎓
        </div>
        <h4 class="text-lg font-bold text-slate-900 mb-2">Técnico SMR Oficial</h4>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Redes locales, switches gestionables, virtualización Proxmox, servidores Linux/Windows, configuración de cortafuegos y prácticas en soporte a usuarios.
        </p>
        <span class="inline-block text-[11px] font-semibold text-cyan-700 bg-cyan-50 px-2.5 py-1 rounded-md">
          Base técnica reglada
        </span>
      </div>

      <!-- Pillar 3 -->
      <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200 hover:border-cyan-400/60 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-amber-100/80 text-amber-700 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🛠️
        </div>
        <h4 class="text-lg font-bold text-slate-900 mb-2">Maker & Diseño CAD</h4>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Modelado paramétrico en Fusion 360, tolerancias para ensambles, selección de filamentos técnicos (PETG/ASA/TPU) y puesta a punto de impresoras.
        </p>
        <span class="inline-block text-[11px] font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-md">
          Prototipado físico real
        </span>
      </div>
    </div>
  </div>
</section>