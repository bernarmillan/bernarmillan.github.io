---
interface ExperienceItem {
  id: number;
  role: string;
  company: string;
  period: string;
  location: string;
  type: "work" | "education" | "self-taught";
  badge: string;
  achievements: string[];
  softSkills?: string[];
  skills?: string[];
}

interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company: string;
}

interface Props {
  experience: ExperienceItem[];
  testimonial: Testimonial;
}

const { experience, testimonial } = Astro.props;

const typeConfig = {
  work: {
    icon: "💼",
    label: "Experiencia Laboral",
    badgeBg: "bg-blue-50 text-blue-800 border-blue-200",
    dotBg: "bg-blue-600",
  },
  education: {
    icon: "🎓",
    label: "Formación Reglada",
    badgeBg: "bg-cyan-50 text-cyan-800 border-cyan-200",
    dotBg: "bg-cyan-600",
  },
  "self-taught": {
    icon: "🛠️",
    label: "Maker Autodidacta",
    badgeBg: "bg-amber-50 text-amber-800 border-amber-200",
    dotBg: "bg-amber-600",
  },
};
---

<section id="experiencia" class="py-16 md:py-24 px-4 sm:px-6 bg-white border-t border-slate-200/60">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-600 mb-2">Trayectoria</h2>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Experiencia & Formación
      </h3>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Constancia contrastada: de la gestión y el trato al cliente a la tecnología
      </p>
      <div class="w-12 h-1 bg-cyan-500 rounded-full mx-auto mt-4"></div>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative border-l-2 border-slate-200 ml-4 sm:ml-6 pl-6 sm:pl-8 space-y-10">
      {experience.map((item) => {
        const config = typeConfig[item.type];
        return (
          <div class="relative group">
            <!-- Timeline Dot -->
            <div class={`absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full ${config.dotBg} border-4 border-white shadow-sm`}></div>

            <!-- Content Card -->
            <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 hover:border-slate-300 hover:shadow-sm transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${config.badgeBg}`}>
                    {config.icon} {config.label}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">
                    {item.period}
                  </span>
                </div>
                <span class="text-xs font-semibold text-slate-600 bg-white px-2 py-0.5 rounded border border-slate-200">
                  {item.badge}
                </span>
              </div>

              <h4 class="text-lg sm:text-xl font-bold text-slate-900 mt-1">
                {item.role}
              </h4>
              <p class="text-sm font-medium text-cyan-700 mb-4">
                {item.company} · <span class="text-slate-500 font-normal">{item.location}</span>
              </p>

              <!-- 3 Impact Bullets -->
              <ul class="space-y-2 mb-4">
                {item.achievements.map(ach => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
                    <span class="text-cyan-600 font-bold mt-0.5">▸</span>
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>

              <!-- Skills tags -->
              {item.softSkills && (
                <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-200/60">
                  <span class="text-xs text-slate-400 font-medium mr-1 flex items-center">Competencias:</span>
                  {item.softSkills.map(skill => (
                    <span class="px-2 py-0.5 bg-white text-slate-600 border border-slate-200 rounded text-xs">
                      {skill}
                    </span>
                  ))}
                </div>
              )}

              {item.skills && (
                <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-200/60">
                  <span class="text-xs text-slate-400 font-medium mr-1 flex items-center">Tecnologías:</span>
                  {item.skills.map(skill => (
                    <span class="px-2 py-0.5 bg-white text-slate-700 border border-slate-200 rounded text-xs font-medium">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Testimonial Quote -->
    <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 text-white shadow-lg relative overflow-hidden">
      <div class="text-cyan-400 text-4xl font-serif mb-2 leading-none">“</div>
      <p class="text-slate-200 text-sm sm:text-base leading-relaxed italic mb-4 font-light">
        {testimonial.quote}
      </p>
      <div class="flex items-center justify-between pt-3 border-t border-slate-700/80 text-xs">
        <div>
          <span class="font-bold text-white block">{testimonial.author}</span>
          <span class="text-slate-400">{testimonial.role} · {testimonial.company}</span>
        </div>
        <span class="text-[11px] uppercase tracking-wider text-cyan-400 font-semibold px-2 py-1 bg-cyan-950/80 rounded border border-cyan-800/60">
          Referencia Laboral
        </span>
      </div>
    </div>
  </div>
</section>