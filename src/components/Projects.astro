---
interface Props {
  projects: Array<{
    id: number;
    title: string;
    description: string;
    problem: string;
    solution: string;
    images: string[];
    renderImage: string;
    tech: string[];
    category: string;
    featured: boolean;
  }>;
}

const { projects } = Astro.props;
const featuredProjects = projects.filter(p => p.featured);
const otherProjects = projects.filter(p => !p.featured);
---

<section id="proyectos" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <header class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">Proyectos 3D Destacados</h2>
      <div class="w-20 h-1 bg-accent mx-auto"></div>
      <p class="text-slate-600 mt-4 max-w-2xl mx-auto">Problema real → Solución impresa. Renders + fotos reales + stack tecnológico</p>
    </header>
    <div class="space-y-16">
      {featuredProjects.map((project, index) => (
        <article class="group grid lg:grid-cols-2 gap-12 items-start" data-aos="fade-up">
          <div class="relative">
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
              <img src={project.renderImage} alt={`Render de ${project.title}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="mt-4 grid grid-cols-2 gap-4">
              {project.images.map((img, i) => (
                <div class="aspect-square rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
                  <img src={img} alt={`Foto real ${i+1} de ${project.title}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
          <div class="lg:pl-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-accent/10 text-accent-dark rounded-full text-sm font-medium">{project.category}</span>
              {project.featured && <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm font-medium">Destacado</span>}
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-primary mb-4">{project.title}</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">{project.description}</p>
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
                <h4 class="font-semibold text-primary mb-2 flex items-center gap-2">
                  <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  Problema
                </h4>
                <p class="text-sm text-slate-600">{project.problem}</p>
              </div>
              <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
                <h4 class="font-semibold text-primary mb-2 flex items-center gap-2">
                  <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Solución
                </h4>
                <p class="text-sm text-slate-600">{project.solution}</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              {project.tech.map(t => (
                <span class="px-3 py-1 bg-primary/5 text-primary border border-primary/20 rounded-full text-sm font-medium">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
      {otherProjects.length > 0 && (
        <div>
          <h3 class="text-xl font-semibold text-primary mb-8 pb-4 border-b border-slate-200">Otros proyectos</h3>
          <div class="grid md:grid-cols-2 gap-8">
            {otherProjects.map(project => (
              <article class="p-6 bg-slate-50 rounded-xl border border-slate-100 hover:border-accent/30 hover:shadow-lg transition-all">
                <h4 class="text-lg font-semibold text-primary mb-2">{project.title}</h4>
                <p class="text-slate-600 text-sm mb-4">{project.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.tech.map(t => (
                    <span class="px-2 py-0.5 bg-white text-slate-600 border border-slate-200 rounded text-xs">{t}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>