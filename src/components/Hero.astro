---
import type { Lang } from '../data/portfolio';
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';

interface Props {
  avatar?: string;
  lang?: Lang;
}

const props = Astro.props;
const lang: Lang = props.lang ?? 'es';
const { personalInfo, cvPillars } = getPortfolio(lang);
const t = getUi(lang);
const avatar = props.avatar ?? personalInfo.avatar;
---

<section 
  id="perfil" 
  class="relative min-h-[100dvh] w-full flex flex-col justify-between pt-20 pb-5 px-4 sm:px-6 md:px-8 max-w-6xl mx-auto z-10"
>
  <!-- Ambient Liquid Glows -->
  <div class="ambient-glow absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-white/[0.03] rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="ambient-glow absolute bottom-10 right-10 w-72 h-72 bg-white/[0.02] rounded-full blur-2xl pointer-events-none -z-10"></div>

  <!-- 1. Top Section: Avatar + Status + Monumental Name -->
  <div class="flex flex-col items-center text-center mt-1 sm:mt-2">
    <!-- Live Status Pill & Avatar Row -->
    <div class="flex flex-col items-center gap-5 mb-2">
      <!-- Status Badge (data-reveal: entrada escalonada al cargar la pantalla) -->
      <div data-reveal class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.06] border border-white/15 backdrop-blur-md text-[11px] font-mono-tech tracking-wider text-zinc-200">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.8)]"></span>
        </span>
        <span>{t.hero.status}</span>
      </div>

      <!-- Avatar Photo Frame with Liquid Chrome Border & Specular Glint (floating) -->
      <div data-reveal data-reveal-delay="60" class="relative flex flex-col items-center">
        <div class="relative group/avatar avatar-float">
          <!-- Liquid chrome rim effect -->
          <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-white/40 via-zinc-600 to-white/60 opacity-60 blur-xs group-hover/avatar:opacity-100 transition-opacity duration-500"></div>
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 md:w-40 md:h-40 rounded-full overflow-hidden border-2 border-white/80 bg-zinc-900 shadow-[0_18px_45px_rgba(0,0,0,0.85)]">
            <img 
              src={avatar} 
              alt={personalInfo.name} 
              class="w-full h-full object-cover object-center saturate-110 group-hover/avatar:scale-105 group-hover/avatar:saturate-125 transition-all duration-700"
              loading="eager"
              onerror="this.src='/images/avatar.svg'"
            />
          </div>
          <!-- Specular Highlight Sheen -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-t from-transparent via-white/10 to-transparent pointer-events-none"></div>
        </div>
        <!-- Light pool under the avatar: shrinks/fades while the avatar rises -->
        <div class="avatar-shadow w-24 h-3 -mt-1 rounded-[50%] bg-white/15 blur-md pointer-events-none"></div>
      </div>
    </div>

    <!-- Monumental Typography -->
    <h1 data-reveal data-reveal-delay="120" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-black uppercase tracking-tight text-white leading-none mt-1">
      {personalInfo.name}
    </h1>

    <!-- Technical Editorial Tagline -->
    <p data-reveal data-reveal-delay="180" class="font-mono-tech text-xs sm:text-sm tracking-wider sm:tracking-widest text-zinc-400 uppercase mt-2 max-w-2xl">
      {t.hero.tagline}
    </p>
  </div>

  <!-- 2. Middle Section: The 3 Condensed CV Capsules (Screen-filling & Zero Scroll) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 my-2 sm:my-3">
    {cvPillars.map((pillar, idx) => (
      <div data-reveal data-reveal-delay={240 + idx * 90} class="glass-card relative p-4 sm:p-5 rounded-2xl flex flex-col justify-between overflow-hidden group">
        <!-- Top border specular shine on hover -->
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <div>
          <!-- Capsule Header / Badge -->
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="font-mono-tech text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-white/10 text-white font-medium">
              {pillar.badge}
            </span>
            <span class="text-zinc-500 text-xs font-mono-tech group-hover:text-zinc-300 transition-colors">
              // 0{cvPillars.indexOf(pillar) + 1}
            </span>
          </div>

          <!-- Capsule Title & Subtitle -->
          <h2 class="font-display text-lg sm:text-xl font-bold text-white tracking-normal group-hover:text-zinc-100 transition-colors">
            {pillar.title}
          </h2>
          <p class="font-mono-tech text-xs text-zinc-400 mb-2.5">
            {pillar.subtitle}
          </p>

          <!-- Executive Summary (sin line-clamp: se ve entera, a petición del usuario) -->
          <p class="text-xs text-zinc-300 leading-relaxed font-sans">
            {pillar.summary}
          </p>
        </div>

        <!-- Skills Micro Badges -->
        <div class="flex flex-wrap gap-1.5 mt-3 pt-2.5 border-t border-white/5">
          {pillar.skills.map((skill) => (
            <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded-full bg-white/5 text-zinc-400 border border-white/5">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- 3. Bottom Row: Scroll Down Trigger -->
  <div data-reveal data-reveal-delay="520" class="flex items-center justify-center pt-2 border-t border-white/10">
    <!-- Explore 3D Projects Trigger -->
    <a 
      href="#proyectos" 
      class="group/scroll inline-flex items-center gap-2 text-xs font-mono-tech text-zinc-400 hover:text-white transition-colors"
    >
      <span class="tracking-widest uppercase text-[11px]">{t.hero.viewProjects}</span>
      <div class="w-6 h-6 rounded-full border border-white/20 flex items-center justify-center group-hover/scroll:border-white group-hover/scroll:translate-y-0.5 transition-all">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </a>
  </div>
</section>
